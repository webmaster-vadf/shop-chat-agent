{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="shop-ai-chat-container">
  <div class="shop-ai-chat-bubble" style="background-color: {{ block.settings.chat_bubble_color | default: '#0C2E72' }}">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </div>

  <div class="shop-ai-chat-window">
    <!-- Header with VADF branding -->
    <div class="shop-ai-chat-header" style="background-color: {{ block.settings.header_background_color | default: '#0C2E72' }}">
      <div class="shop-ai-header-content">
        {% if block.settings.logo_image %}
          <img src="{{ block.settings.logo_image | image_url: width: 200 }}" alt="Logo" class="shop-ai-logo" width="200" height="auto" loading="lazy">
        {% else %}
          <img src="{{ block.settings.logo_url | asset_url  }}" alt="Logo" class="shop-ai-logo" width="200" height="32" loading="lazy">
        {% endif %}
        <button class="shop-ai-chat-close">✕</button>
      </div>
      <h2 class="shop-ai-welcome-text">{{ block.settings.welcome_message | default: "Bonjour, comment puis-je vous aider ?" }}</h2>
    </div>

    <!-- Support Menu View -->
    <div class="shop-ai-support-content" id="supportMenu">
      <!-- Message card -->
      <div class="shop-ai-message-card" id="openChatBtn">
        <svg class="shop-ai-message-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span class="shop-ai-message-card-text">Envoyez-nous un message</span>
      </div>

      <!-- FAQ Links -->
      <div class="shop-ai-faq-links">
        <a href="https://vadf.fr/pages/faq#compte-client" class="shop-ai-faq-link" target="_blank" rel="noopener">
          <span>Compte client</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a href="https://vadf.fr/pages/faq#produits" class="shop-ai-faq-link" target="_blank" rel="noopener">
          <span>Produits</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a href="https://vadf.fr/pages/faq#fabrication" class="shop-ai-faq-link" target="_blank" rel="noopener">
          <span>Fabrication</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
        <a href="https://vadf.fr/pages/faq#reliquat" class="shop-ai-faq-link" target="_blank" rel="noopener">
          <span>Reliquat</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </div>

    <!-- Chat View (hidden by default) -->
    <div class="shop-ai-chat-view" id="chatView" style="display: none;">
      <!-- Back button -->
      <button class="shop-ai-back-btn" id="backToMenuBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Retour au menu</span>
      </button>

      <!-- Messages container -->
      <div class="shop-ai-chat-messages">
        <!-- Messages will be added here by JavaScript -->
      </div>

      <!-- Input area -->
      <div class="shop-ai-chat-input">
        <input type="text" placeholder="Écrivez votre message...">
        <button class="shop-ai-chat-send">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | default: 'vadfAssistant' | json }},
    language: {{ block.settings.language | default: 'fr' | json }},
    apiBaseUrl: {{ block.settings.api_base_url | default: 'https://shop-chat-agent-bold-flower-713.fly.dev' | json }}
  };
  window.shopId = {{ shop.id }};
</script>

{% schema %}
{
  "name": "VADF Support Modal",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Interface de support client VADF avec liens vers la FAQ. Personnalisez les couleurs et le message d'accueil ci-dessous."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo",
      "info": "Logo affiché dans le header (recommandé : logo blanc sur fond transparent)"
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "URL du logo (alternative)",
      "default": "https://vadf.fr/cdn/shop/files/logo-vadf-blanc.png",
      "info": "Si aucune image n'est sélectionnée ci-dessus, cette URL sera utilisée"
    },
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Couleur de la bulle",
      "default": "#0C2E72",
      "info": "Couleur de la bulle de chat (bleu VADF par défaut)"
    },
    {
      "type": "color",
      "id": "header_background_color",
      "label": "Couleur du header",
      "default": "#0C2E72",
      "info": "Couleur de fond du header (bleu VADF par défaut)"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Message d'accueil",
      "default": "Bonjour, comment puis-je vous aider ?",
      "info": "Message affiché dans le header"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "Type d'assistant",
      "options": [
        {
          "value": "vadfAssistant",
          "label": "Assistant VADF"
        },
        {
          "value": "standardAssistant",
          "label": "Assistant Standard"
        }
      ],
      "default": "vadfAssistant"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "URL de l'API",
      "default": "https://shop-chat-agent-bold-flower-713.fly.dev",
      "info": "URL du serveur de chat (ne modifiez que si nécessaire)"
    }
  ]
}
{% endschema %}
